# =============================================================================
# BuyWise — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.Python

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb.bak

# ── Secrets / Environment Variables ──────────────────────────────────────────
.env
.env.local
.env.production
*.secret
secrets.json

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm

# ── ML Artifacts ─────────────────────────────────────────────────────────────
# Trained model binaries — regenerate from pipeline
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt

# Raw and processed data — too large for version control
data/raw/*.csv
data/raw/*.json
data/raw/*.xlsx
data/processed/*.csv
data/processed/*.json

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Pytest / Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── MongoDB ──────────────────────────────────────────────────────────────────
*.db
mongod.pid
