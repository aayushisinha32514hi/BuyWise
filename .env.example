# BuyWise Configuration — 2026 Live Shopping Search
# ====================================================

# SerpAPI API Key for Live Google Shopping (India)
# Sign up free at: https://serpapi.com/users/sign_up (250 free searches/month, no credit card required)
SERPAPI_KEY=your_serpapi_key_here

# Cache TTL in hours to conserve free monthly API calls (default: 6 hours)
CACHE_TTL_HOURS=6

# Default Market Configuration
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en
DEFAULT_LOCATION=India
